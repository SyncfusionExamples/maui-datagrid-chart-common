<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="MAUIComponentsDemo.MainFlyoutPage"
            Title="Syncfusion Components"
            BackgroundColor="#F5F5F5">

    <FlyoutPage.Resources>
        <Style TargetType="Label" x:Key="MenuHeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#1F1F1F"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style TargetType="Label" x:Key="MenuItemStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="#424242"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>
    </FlyoutPage.Resources>

    <!-- Flyout (Menu) -->
    <FlyoutPage.Flyout>
        <ContentPage Title="Menu" BackgroundColor="#FFFFFF" Padding="0">
            <Grid RowDefinitions="Auto,*" BackgroundColor="#FFFFFF">
                <!-- Header Section -->
                <StackLayout Grid.Row="0" 
                           BackgroundColor="#2196F3" 
                           Padding="20,40,20,20" 
                           Spacing="0">
                    <Label Text="Components" 
                          FontSize="22" 
                          FontAttributes="Bold" 
                          TextColor="White"/>
                </StackLayout>

                <!-- Menu Items -->
                <CollectionView Grid.Row="1"
                               x:Name="collectionView"
                               SelectionMode="Single"
                               SelectionChangedCommand="{Binding SelectionChangedCommand}"
                               SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
                               ItemsSource="{Binding MenuItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="0" Spacing="0" BackgroundColor="Transparent">
                                <Frame Padding="0" Margin="8,4,8,4" CornerRadius="8" HasShadow="False" BackgroundColor="Transparent" BorderColor="Transparent">
                                    <StackLayout Padding="16,12" Spacing="0" BackgroundColor="#F5F5F5">
                                        <Label Text="{Binding Title}"
                                              FontSize="15"
                                              TextColor="#424242"
                                              FontAttributes="Bold"/>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>

    <!-- Detail Page -->
    <FlyoutPage.Detail>
        <NavigationPage x:Name="detailPage" BarBackgroundColor="#2196F3" BarTextColor="White" IconColor="White">
            <x:Arguments>
                <ContentPage Title="Syncfusion Components"  BackgroundColor="#F5F5F5">
                    <Grid RowDefinitions="*"  ColumnDefinitions="*" BackgroundColor="#F5F5F5">
                        <StackLayout Grid.Row="0" 
                                   Grid.Column="0"
                                   VerticalOptions="CenterAndExpand" 
                                   HorizontalOptions="CenterAndExpand" 
                                   Spacing="16" 
                                   Padding="40">
                            <Frame Padding="30" 
                                  CornerRadius="12" 
                                  HasShadow="True" 
                                  BackgroundColor="White"
                                  BorderColor="#E0E0E0"
                                  Margin="0">
                                <StackLayout Spacing="16" HorizontalOptions="CenterAndExpand">
                                    <Label Text="🎯"
                                          FontSize="48"
                                          HorizontalTextAlignment="Center"/>
                                    <Label Text="Welcome to Syncfusion MAUI Components"
                                          FontSize="22"
                                          FontAttributes="Bold"
                                          HorizontalTextAlignment="Center"
                                          TextColor="#1F1F1F"/>
                                    <Label Text="Select a component from the menu to get started"
                                          FontSize="14"
                                          HorizontalTextAlignment="Center"
                                          TextColor="#757575"
                                          LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Grid>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>
